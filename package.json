{
    "name": "claude-token-visualizer",
    "version": "0.0.1",
    "private": true,
    "type": "module",
    "scripts": {
        "m1": "tsx m1/usage-probe.ts",
        "typecheck": "tsc --noEmit",
        "format:check": "prettier --check ."
    },
    "devDependencies": {
        "@types/node": "^22.10.0",
        "prettier": "^3.8.3",
        "tsx": "^4.19.2",
        "typescript": "^5.7.0"
    },
    "prettier": {
        "tabWidth": 4,
        "useTabs": false,
        "semi": true,
        "trailingComma": "all",
        "singleQuote": true,
        "printWidth": 100,
        "arrowParens": "always",
        "endOfLine": "lf"
    }
}
